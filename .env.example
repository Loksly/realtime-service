PORT=3000

# --- Redis ---
# Sensitive: also loaded from /var/run/secrets/redis_url
REDIS_URL=redis://localhost:6379
REDIS_DB=0
REDIS_KEY_PATTERN=*

# --- JWT ---
# Algorithm: HS256 (default) or RS256
JWT_ALGORITHM=HS256

# HS256: sensitive – also loaded from /var/run/secrets/jwt_secret
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=24h

# RS256: sensitive – also loaded from /var/run/secrets/jwt_public_key
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# JWT_PUBLIC_KEY_FILE=/path/to/public.pem

# --- Secrets directory (Docker / Kubernetes secret mounts) ---
# Defaults to /var/run/secrets. Override for local development or tests.
# SECRETS_DIR=/var/run/secrets

# --- Rate limiting ---
# Maximum requests per IP per window (default: 100 req / 60 s)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

LOG_LEVEL=info
AUDIT_LOG_FILE=logs/audit.log
APP_LOG_FILE=logs/app.log
